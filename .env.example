# --- PayPal (sandbox) -------------------------------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: the ID of the webhook you register for CUSTOMER.DISPUTE.* events.
# When set, incoming webhooks are signature-verified with PayPal.
PAYPAL_WEBHOOK_ID=

# --- AI ----------------------------------------------------------------------
# Option A: Anthropic API
ANTHROPIC_API_KEY=
# Option B: Claude on Amazon Bedrock. Uses the standard AWS credential chain
# (~/.aws, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), no Anthropic key.
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# ANTHROPIC_MODEL=global.anthropic.claude-sonnet-4-6   (any Claude model or inference profile your account can call)
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_DAILY_RUN_LIMIT=60

# --- Demo mode ---------------------------------------------------------------
# With no PayPal credentials the app runs against a built-in PayPal simulator
# that mirrors the Disputes API lifecycle, so the whole flow can be tried
# without any PayPal account. Set to "true" to force the simulator.
# PAYPAL_MOCK=true
